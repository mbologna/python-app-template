# Shared pipeline (mbologna/ci-templates), all components at one version:
# - merge requests: the commit check (container-app includes commits),
#   hadolint when the Dockerfile changed, ruff and the
#   tests with the coverage gate (fail_under in pyproject.toml) and
#   pip-audit, and a no-push build check with the image policy check;
# - a push to main: only a CVE fix releases;
# - Monday's schedule (0 6 * * 1, main): auto-release tags vX.Y.Z when a
#   feat, fix, perf, revert or breaking commit landed, or a maintenance
#   release for dependency updates (needs the AUTO_RELEASE_TOKEN variable);
{%- set subdirs = extra_images.split() %}
{%- if subdirs %}
# - a vX.Y.Z tag, for each image that changed: build, policy check, smoke
#   test, Trivy report, push X.Y.Z, X.Y and latest, sign.
{%- elif smoke_cmd == 'auto' %}
# - a vX.Y.Z tag: build, policy check, smoke test (smoke_cmd auto imports
#   every installed package), Trivy report, push X.Y.Z, X.Y and latest, sign.
{%- else %}
# - a vX.Y.Z tag: build, policy check, smoke test (smoke_cmd), Trivy
#   report, push X.Y.Z, X.Y and latest, sign.
{%- endif %}
include:
  - component: gitlab.com/mbologna/ci-templates/base@8.2.0
  - component: gitlab.com/mbologna/ci-templates/container-app@8.2.0
    inputs:
      strategy: conventional
{%- if smoke_cmd != 'auto' %}
      smoke_cmd: '{{ smoke_cmd | replace("'", "''") }}'
{%- endif %}
{%- if subdirs %}
      # The security strategy compares every image's base image.
      dockerfiles: Dockerfile{% for d in subdirs %} {{ d }}/Dockerfile{% endfor %}
      # One release and check job per image. Each image's IMAGE_SKIP_PATHS
      # adds the files that don't go into it to skip_paths; a release
      # rebuilds only the images whose files changed. hadolint in CI lints
      # the first Dockerfile only; pre-commit lints them all.
      images:
        - IMAGE_DOCKERFILE: Dockerfile
          IMAGE_SKIP_PATHS: "{% for d in subdirs %}{{ d }}/*{{ ' ' if not loop.last else '' }}{% endfor %}"
{%- for d in subdirs %}
        - IMAGE_DOCKERFILE: {{ d }}/Dockerfile
          IMAGE_SUBPATH: {{ d }}
{%- if smoke_cmd != 'auto' %}
          IMAGE_SMOKE_CMD: auto
{%- endif %}
          IMAGE_SKIP_PATHS: "src/* Dockerfile pyproject.toml uv.lock requirements-uv.txt{% for o in subdirs if o != d %} {{ o }}/*{% endfor %}"
{%- endfor %}
{%- endif %}
  - component: gitlab.com/mbologna/ci-templates/python-test@8.2.0

test:
  # The Python the image ships: the Dockerfile's final stage, which the
  # same Renovate update moves.
{%- if base_variant == "alpine" %}
  image: python:3.15.2-alpine@sha256:0f9552bb28711333da16915ec146f5e6bb44a7fdac9ced15dc17c2e0206346dd
{%- else %}
  image: python:3.15.2-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928
{%- endif %}
