[project]
name = "{{ project_name }}"
{%- if kind == 'package' and pypi_publish %}
# A placeholder, never bumped: a release is the git tag vX.Y.Z that
# auto-release creates, and publish.yml builds the tag with its version for
# PyPI. Nothing reads this field at run time.
{%- elif kind == 'package' and changelog_releases %}
# A placeholder, never bumped: a release is the git tag vX.Y.Z that
# auto-release creates, with a {{ 'GitHub' if forge == 'github' else 'GitLab' }} Release of the commit subjects; it
# builds nothing. Nothing reads this field at run time.
{%- elif kind == 'package' %}
# A placeholder, never bumped: this project has no releases. Nothing reads
# this field at run time.
{%- elif forge == 'gitlab' or releases %}
# A placeholder, never bumped: a release is the git tag vX.Y.Z that
# auto-release creates, and the image built from that tag carries the
# version in its org.opencontainers.image.version label. Nothing reads this
# field at run time.
{%- elif changelog_releases %}
# A placeholder, never bumped: each push to main publishes its image as
# latest and sha-<commit>, and the git tag vX.Y.Z that auto-release creates
# marks a changelog entry with no image of its own. Nothing reads this field
# at run time.
{%- else %}
# A placeholder, never bumped: this project has no releases, and each push
# to main publishes its image as latest and sha-<commit>. Nothing reads this
# field at run time.
{%- endif %}
version = "0.0.0"
description = "{{ description }}"
readme = "README.md"
{%- if license == 'other' %}
license = "{{ license_expression }}"
license-files = ["LICENSE", "LICENSES/*"]
{%- elif license != 'none' %}
license = "{{ license }}"
{%- endif %}
authors = [{ name = "{{ author }}" }]
{%- if kind == 'package' %}
# The oldest Python the package supports. CI tests on 3.15 only; ruff's
# target-version below keeps syntax and pyupgrade fixes within this floor.
requires-python = ">={{ python_floor }}"
{%- else %}
# The Python the Dockerfile's base image ships; Renovate moves the image,
# a person moves this floor with the next minor.
requires-python = ">=3.15"
{%- endif %}
dependencies = [
{%- if notifications %}
    "apprise>=2.2.0",
{%- endif %}
]
{%- if kind == 'app' or script_target %}

[project.scripts]
{%- if kind == 'app' and entrypoint == 'none' %}
# Several programs and no default: each deployment runs one of these.
{%- endif %}
{%- if kind == 'package' or entrypoint != 'none' or sample_code %}
{{ project_name }} = "{{ script_target }}"
{%- endif %}
{%- endif %}

[build-system]
requires = ["uv_build>=0.13,<0.14"]
build-backend = "uv_build"

[dependency-groups]
dev = [
    "pre-commit>=4.5.1",
    "pytest>=9.0.3",
    "pytest-cov>=7.1.0",
    "ruff>=0.17.0",
]

[tool.uv]
required-version = ">=0.12.12"
# Resolve only releases at least 7 days old, so a compromised release has
# time to be caught and yanked before it lands in uv.lock. For an urgent
# fix, add `<name> = false` to exclude-newer-package and run `uv lock`.
exclude-newer = "7 days"

[tool.ruff]
line-length = 120
target-version = "{% if kind == 'package' %}py{{ python_floor | replace('.', '') }}{% else %}py315{% endif %}"

[tool.ruff.lint]
select = [
    "E",   # pycodestyle errors
    "W",   # pycodestyle warnings
    "F",   # pyflakes
    "I",   # isort
    "B",   # flake8-bugbear
    "C4",  # flake8-comprehensions
    "UP",  # pyupgrade
]
ignore = [
    "E501",  # line too long (the formatter handles it)
]

[tool.ruff.format]
quote-style = "double"
indent-style = "space"

[tool.mypy]
# The pre-commit hook passes mypy only the staged files: without this, a
# commit that touches only tests checks them against an unresolved package
# (every import Any) and leaves a cache that fails the next full run.
mypy_path = "src"

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-v --strict-markers"

[tool.bandit]
exclude_dirs = ["tests"]

[tool.coverage.run]
source = ["{{ package_name }}"]
{%- if main_module %}
# `python -m {{ package_name }}` only calls main().
omit = ["*/__main__.py"]
{%- endif %}

[tool.coverage.report]
# CI fails below this total (python-ci and ci-templates' python-test read
# it). Raise it with the tests; don't lower it to merge.
fail_under = {{ coverage_fail_under }}
show_missing = true
