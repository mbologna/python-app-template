name: Commits
{% if releases or changelog_releases %}
# Pull requests merge with a merge commit, so every commit lands on the
# default branch as it is, and auto-release reads the subjects: each must
# follow the commit rules (mbologna/commitlint-config), and no fixup! commit
# may remain.
{%- else %}
# Pull requests merge with a merge commit, so every commit lands on the
# default branch as it is: each must follow the commit rules
# (mbologna/commitlint-config), and no fixup! commit may remain.
{%- endif %}

"on":
  pull_request:

permissions:
  pull-requests: read

jobs:
  commits:
    uses: mbologna/.github/.github/workflows/commits.yml@b6ef2e0e959b0f8d3c64c7b3c86f8736229b74a0 # main
