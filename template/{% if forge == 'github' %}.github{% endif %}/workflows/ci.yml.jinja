{%- set changelog = changelog_releases and not releases -%}
name: CI

"on":
  push:
    branches: [main]
{%- if releases %}
    tags: ["v*.*.*"]
{%- endif %}
  pull_request:
{%- if releases or changelog %}
  schedule:
    - cron: "0 6 * * 1"
{%- endif %}
  workflow_dispatch:

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
{%- if releases %}
  # Never cancel a run on the default branch: it may be releasing, and a cut
  # release leaves a tag without its Release.
{%- elif changelog %}
  # Never cancel a run on the default branch: it may be {% if cloud_run != 'none' %}deploying or {% endif %}releasing,
  # and a cut release leaves a tag without its Release.
{%- elif cloud_run != 'none' %}
  # Never cancel a run on the default branch: it may be deploying.
{%- else %}
  # Never cancel a run on the default branch: it may be pushing the image.
{%- endif %}
  cancel-in-progress: {% raw %}${{ github.ref != format('refs/heads/{0}', github.event.repository.default_branch) }}{% endraw %}

permissions:
  contents: read

jobs:
  # ruff, the tests with the coverage gate (fail_under in pyproject.toml)
  # and pip-audit on the locked runtime dependencies.
  python:
    uses: mbologna/.github/.github/workflows/python-ci.yml@423fe81596d69d9cd74191195ee6d3af7f9bf360 # main
    with:
      python_version: "3.15"
      enable_codecov: {{ codecov | lower }}
    secrets: inherit

  docker:
    needs: python
{%- if releases %}
    # contents: the release tag and its Release; actions: dispatch the tag
    # build (a tag pushed with GITHUB_TOKEN triggers no run); the rest:
    # push, sign and scan the image.
    permissions:
      contents: write
      packages: write
      id-token: write
      attestations: write
      security-events: write
      actions: write
{%- else %}
    # Push, sign and scan the image{% if cloud_run != 'none' %}, and deploy it{% endif %}.
    permissions:
      contents: read
      packages: write
      id-token: write
      attestations: write
      security-events: write
{%- endif %}
    uses: mbologna/.github/.github/workflows/docker-ci.yml@423fe81596d69d9cd74191195ee6d3af7f9bf360 # main
    with:
      image_name: {{ project_name }}
{%- if releases %}
      # Only release tags publish the image (auto-release dispatches
      # their build); pull requests build it without pushing.
      publish: release
{%- else %}
{%- if changelog %}
      # Every push to main publishes the image, tagged latest and
      # sha-<commit>; pull requests build it without pushing. The release
      # tags build nothing.
{%- else %}
      # Every push to main publishes the image, tagged sha-<commit>;
      # pull requests build it without pushing.
{%- endif %}
      publish: push
{%- endif %}
      push_to_dockerhub: false
      # The image must start before anything is {% if releases %}tagged{% else %}pushed{% endif %}: run without network
      # or configuration, this exits 0 only when the code and its
      # dependencies import.
      smoke_cmd: '{{ smoke_cmd | replace("'", "''") }}'
{%- if releases %}
      # auto-release runs inside docker-ci: Monday's schedule releases with
      # this strategy (and a maintenance release for dependency updates), a
      # push to main only a CVE fix.
      release_strategy: conventional
{%- elif changelog %}
      # No release_strategy: its auto-release would dispatch a tag build
      # that publishes X.Y.Z images, which nothing runs. The auto-release
      # job below tags the changelog instead.
{%- else %}
      # No release_strategy: every push to main publishes its own sha-*
      # image, so a version tag would mark nothing that runs.
{%- endif %}
{%- if cloud_run != 'none' and changelog %}
      # Points the Cloud Run {{ cloud_run }} at the image digest of each push or
      # manual run on main that builds one; a docs- or CI-only push deploys
      # nothing. Needs the GCP_WORKLOAD_IDENTITY_PROVIDER and
      # GCP_SERVICE_ACCOUNT secrets.
      deploy_type: {{ cloud_run }}
{%- elif cloud_run != 'none' %}
      # Points the Cloud Run {{ cloud_run }} at the image of each push or manual
      # run on main that builds one; a docs- or CI-only push deploys nothing.
      # Needs the GCP_WORKLOAD_IDENTITY_PROVIDER and GCP_SERVICE_ACCOUNT
      # secrets.
      deploy_type: {{ cloud_run }}
{%- endif %}
    secrets: inherit
{%- if changelog %}

  # Release tags as a changelog: Monday's schedule tags vX.Y.Z with a GitHub
  # Release of the commit subjects when a feat, fix, perf, revert or
  # breaking commit landed (or a maintenance release for dependency
  # updates), and a push to main tags only a CVE fix (a fix(security)
  # commit, or a Dockerfile base image update that fixes CVEs). A tag
  # records what main already {% if cloud_run != 'none' %}deployed{% else %}published{% endif %}; it builds nothing.
  auto-release:
    needs: [python, docker]
    # contents: push the tag and create the Release.
    permissions:
      contents: write
    uses: mbologna/.github/.github/workflows/auto-release.yml@423fe81596d69d9cd74191195ee6d3af7f9bf360 # main
    with:
      strategy: conventional
      # The security strategy compares this Dockerfile's base image at the
      # last tag and at the pushed commit. No image input: there is no X.Y.Z
      # image to scan, so no fresh-rebuild release either.
      dockerfiles: Dockerfile
      dispatch_tag_build: false
    secrets: inherit
{%- endif %}
