from {{ package_name }} import build_report, main


def test_report_without_items_is_not_a_problem():
    title, body, problem = build_report([])
    assert not problem
    assert title.endswith("all good")
    assert body == "Nothing to report."


def test_report_lists_items_once_sorted():
    title, body, problem = build_report(["b", " a ", "b", ""])
    assert problem
    assert "2 to look at" in title
    assert body == "- a\n- b"


def test_help_exits_zero(capsys):
    with pytest.raises(SystemExit) as exc:
        main(["--help"])
    assert exc.value.code == 0
    assert "{{ project_name }}" in capsys.readouterr().out


def test_clean_run_exits_zero():
    assert main([]) == 0
