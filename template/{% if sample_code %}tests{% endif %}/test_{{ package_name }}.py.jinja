def test_problem_is_sent_to_apprise(sent):
    assert main(["disk full"]) == 1
    assert sent == [("http://a/notify/k http://b/notify/k", "{{ project_name }}: 1 to look at", {"type_": "warning"})]


def test_dry_run_sends_nothing(sent):
    assert main(["--dry-run", "disk full"]) == 1
