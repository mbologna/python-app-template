"""{{ description }}

An example to replace: one run builds a report{% if notifications %} and, unless --dry-run is
given, sends it through Apprise{% endif %}, then exits non-zero when something
needs attention, so a failed Job shows up in the cluster too.
"""

import argparse
{%- if notifications %}
import os
import urllib.parse

import apprise
{%- endif %}

__all__ = ["build_report", "main"]
{%- if notifications %}

# Seconds before the one retry of an Apprise URL.
_RETRY_WAIT_SECONDS = 1
# Seconds each attempt may take to connect, and then to read the reply.
_TIMEOUT_SECONDS = 15


def apprise_api_url(url: str, timeout: int = _TIMEOUT_SECONDS) -> str:
    """The apprise library's URL for an Apprise API endpoint, http(s)://host:port/notify/<key>.

    JSON to /notify/<key> (version=1), with one retry, and the timeout for the
    connect (cto) as well as each read (rto). Any query on the URL is dropped.
    """
    parsed = urllib.parse.urlsplit(url)
    scheme = "apprises" if parsed.scheme == "https" else "apprise"
    prefix, _, key = parsed.path.rpartition("/notify/")
    path = f"{prefix.strip('/')}/{key}".lstrip("/")
    return (
        f"{scheme}://{parsed.netloc}/{path}?method=json&version=1"
        f"&retry=1&wait={_RETRY_WAIT_SECONDS}&cto={timeout}&rto={timeout}"
    )


def notify(urls: str, title: str, body: str, notify_type: str = "info") -> bool:
    """Send a notification to the first of `urls` that delivers.

    `urls` holds one Apprise API notify URL, or several separated by
    whitespace. Each becomes its own apprise priority group, so they are tried
    in order, each retried once before the next. Returns False when nothing
    delivered or there is no URL; apprise logs the failures.
    """
    notifier = apprise.Apprise()
    for priority, url in enumerate(urls.split(), start=1):
        notifier.add(apprise_api_url(url), tag=f"{priority}:notify")
    if not len(notifier):
        return False
    return bool(notifier.notify(title=title, body=body, notify_type=notify_type, tag="notify"))
{%- endif %}


def build_report(items: list[str]) -> tuple[str, str, bool]:
    """Return the notification title and body, and whether it is a problem.

    Pure logic, no I/O: the part of an application worth most of its tests.
    """
    problems = sorted({item.strip() for item in items if item.strip()})
    if not problems:
        return "{{ project_name }}: all good", "Nothing to report.", False
    body = "\n".join(f"- {item}" for item in problems)
    return f"{{ project_name }}: {len(problems)} to look at", body, True


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="{{ project_name }}", description=__doc__.splitlines()[0])
    parser.add_argument("items", nargs="*", help="items to report (example input)")
{%- if notifications %}
    parser.add_argument("--dry-run", action="store_true", help="print the report instead of sending it")
{%- endif %}
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    title, body, problem = build_report(args.items)
    print(f"{title}\n{body}")
{%- if notifications %}
    if problem and not args.dry_run:
        # APPRISE_URL holds one Apprise API notify URL, or several separated by
        # spaces, tried in order until one delivers. Empty sends nothing.
        notify(os.environ.get("APPRISE_URL", ""), title, body, notify_type="warning")
{%- endif %}
    return 1 if problem else 0
