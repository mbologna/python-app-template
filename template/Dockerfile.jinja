{%- set slim = base_variant != "alpine" -%}
{%- set has_license_file = license not in ["none"] -%}
{%- set ships_releases = forge == "gitlab" or releases -%}
# Build stage: a pinned uv installs exactly what uv.lock pins into
# /opt/venv. Same base image and digest as the runtime stage, so compiled
# wheels match the Python they run on.
{% if base_variant == "alpine" -%}
FROM python:3.15.2-alpine@sha256:0f9552bb28711333da16915ec146f5e6bb44a7fdac9ced15dc17c2e0206346dd AS build
{%- else -%}
FROM python:3.15.2-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928 AS build
{%- endif %}

{% if build_packages.split() -%}
# Packages only the build needs, for dependencies built from source; the
# runtime stage takes nothing but /opt/venv from here. Unpinned: the base
# image digest fixes the distribution release they come from.
{% if slim -%}
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends {{ build_packages.split() | join(" ") }} \
    && rm -rf /var/lib/apt/lists/*
{% else -%}
# hadolint ignore=DL3018
RUN apk add --no-cache {{ build_packages.split() | join(" ") }}
{% endif -%}
{% endif -%}
# uv from PyPI, hash-checked (requirements-uv.txt says why).
COPY requirements-uv.txt /tmp/
RUN pip install --no-cache-dir --root-user-action=ignore --require-hashes -r /tmp/requirements-uv.txt
# Install exactly what uv.lock pins, checking its hashes, rather than
# re-resolving pyproject.toml at build time; --locked fails the build when
# uv.lock is out of date. Dependencies first, so their layer survives a change
# to the code or the docs; then the app itself, as a regular (non-editable)
# package. Bytecode is compiled here because the runtime image sets
# PYTHONDONTWRITEBYTECODE and runs read-only.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON=/usr/local/bin/python3 UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_NO_CACHE=1
WORKDIR /tmp/build
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-editable --no-install-project
COPY README.md{% if has_license_file %} LICENSE{% endif %} ./
{%- if license == "other" %}
COPY LICENSES/ LICENSES/
{%- endif %}
COPY src/ src/
RUN uv sync --locked --no-dev --no-editable

{% if base_variant == "alpine" -%}
FROM python:3.15.2-alpine@sha256:0f9552bb28711333da16915ec146f5e6bb44a7fdac9ced15dc17c2e0206346dd
{%- else -%}
FROM python:3.15.2-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928
{%- endif %}
{%- if ships_releases %}
# The CI pipeline adds org.opencontainers.image.source and .revision, and
# .version from the release tag (pyproject.toml's version is a placeholder).
{%- else %}
# The CI pipeline adds org.opencontainers.image.source and .revision; there
# are no release tags, so no .version (pyproject.toml's is a placeholder).
{%- endif %}
LABEL org.opencontainers.image.title="{{ project_name }}" \
      org.opencontainers.image.description="{{ description }}"
{%- if license != "none" %} \
      org.opencontainers.image.licenses="{{ license_expression if license == 'other' else license }}"
{%- endif %}
COPY --from=build /opt/venv /opt/venv
# Run-time writes go to /tmp (HOME too), so the root filesystem can be
# read-only.
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
{%- if port or runtime_env.split() %}
{%- if port %}
# PORT: where the server listens. Cloud Run and most container runtimes set
# it; {{ port }} otherwise.
{%- endif %}
ENV {% if port %}PORT={{ port }}{% if runtime_env.split() %} {% endif %}{% endif %}{{ runtime_env.split() | join(" ") }}
{%- endif %}
# The base image's pip (with the packages it vendors) and ensurepip's
# bundled pip wheel are never used at run time; removing them keeps their
# CVEs out of the image.
RUN /usr/local/bin/python3 -m pip uninstall -y --root-user-action=ignore pip \
    && rm -rf /usr/local/lib/python3*/ensurepip
{%- if image_user or writable_dirs.split() %}
{%- set steps = [] %}
{%- if image_user and slim %}
{%- set _ = steps.append("groupadd -g %d %s && useradd -r -u %d -g %d -d /nonexistent -s /usr/sbin/nologin %s" | format(image_uid, image_user, image_uid, image_uid, image_user)) %}
{%- elif image_user %}
{%- set _ = steps.append("addgroup -S -g %d %s && adduser -S -D -H -u %d -G %s -h /nonexistent -s /sbin/nologin %s" | format(image_uid, image_user, image_uid, image_user, image_user)) %}
{%- endif %}
{%- if writable_dirs.split() %}
{%- set _ = steps.append("mkdir -p %s && chown %d:%d %s" | format(writable_dirs.split() | join(" "), image_uid, image_uid, writable_dirs.split() | join(" "))) %}
{%- endif %}
{%- if image_user %}
# A named account for the UID, for software that looks it up in
# /etc/passwd, with a fixed GID so volumes see the same numbers on every
# build.
{%- endif %}
{%- if writable_dirs.split() %}
# The directories the app writes to besides /tmp, owned by its UID, so a
# new volume mounted on one starts writable.
{%- endif %}
RUN {{ steps | join(" \\\n    && ") }}
{%- endif %}
# The distribution's security fixes published since the base image was
# built: Docker's official images are rebuilt only every week or few.
{%- if ships_releases %}
# auto-release's fresh rebuild counts the base image's findings because of
# this line, so a fix ships within a week without a base image update.
{%- else %}
# Each push to main that rebuilds the image takes the fixes released since.
{%- endif %}
{%- if runtime_packages.split() %}
# Then the packages the app needs at run time, unpinned: the base image
# digest fixes the distribution release they come from.
{%- if slim %}
# hadolint ignore=DL3008
{%- else %}
# hadolint ignore=DL3018
{%- endif %}
{%- endif %}
{% if base_variant == "alpine" -%}
RUN apk upgrade --no-cache
{%- if runtime_packages.split() %} \
    && apk add --no-cache {{ runtime_packages.split() | join(" ") }}
{%- endif %}
{%- else -%}
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
{%- if runtime_packages.split() %}
    && apt-get install -y --no-install-recommends {{ runtime_packages.split() | join(" ") }} \
{%- endif %}
    && rm -rf /var/lib/apt/lists/*
{%- endif %}
USER {{ image_uid }}:{{ image_uid }}
{%- if port %}
EXPOSE {{ port }}
{%- endif %}
{%- if entrypoint == "entrypoint" %}
ENTRYPOINT ["{{ project_name }}"]
{%- elif entrypoint == "cmd" %}
# Several programs: {{ project_name }} by default, and a deployment's command
# (or `docker run <image> <script>`) picks another from [project.scripts].
CMD ["{{ project_name }}"]
{%- else %}
# Several programs and no default: each deployment's command (or
# `docker run <image> <script>`) names one from [project.scripts].
{%- endif %}
